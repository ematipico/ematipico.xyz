---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

<aside class="contents lg:col-start-2 lg:row-start-1 lg:block">
	<details
		data-mobile-table-of-contents
		class="sticky top-16 z-40 mb-8 max-h-[calc(100dvh-8rem)] overflow-y-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/95 lg:hidden"
	>
		<summary class="cursor-pointer px-4 py-3 text-sm font-semibold">
			On this page
		</summary>
		<nav
			aria-label="Table of contents"
			class="border-t border-gray-200 px-4 py-3 dark:border-gray-700"
		>
			<ol class="m-0 list-none space-y-2 p-0 text-sm">
				{headings.map((heading) => (
					<li class:list={["m-0", heading.depth === 3 && "pl-4"]}>
						<a class="block no-underline" href={`#${heading.slug}`}>
							{heading.text}
						</a>
					</li>
				))}
			</ol>
		</nav>
	</details>

	<nav
		aria-labelledby="table-of-contents-title"
		class="hidden lg:sticky lg:top-24 lg:block"
	>
		<div
			id="table-of-contents-title"
			class="mb-3 text-sm font-semibold text-gray-900 dark:text-gray-100"
		>
			On this page
		</div>
		<ol
			class="m-0 list-none space-y-2 border-l border-gray-200 p-0 pl-4 text-sm dark:border-gray-700"
		>
			{headings.map((heading) => (
				<li class:list={["m-0", heading.depth === 3 && "pl-3"]}>
					<a class="block no-underline" href={`#${heading.slug}`}>
						{heading.text}
					</a>
				</li>
			))}
		</ol>
	</nav>
</aside>

<script>
document
	.querySelectorAll<HTMLDetailsElement>("[data-mobile-table-of-contents]")
	.forEach((tableOfContents) => {
		tableOfContents.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) {
				tableOfContents.removeAttribute("open");
			}
		});
	});
</script>
